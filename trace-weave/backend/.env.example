APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8787
WEB_ORIGIN=http://127.0.0.1:5173

DB_HOST=127.0.0.1
DB_PORT=15432
DB_NAME=zi
DB_USER=postgres
DB_PASSWORD=replace_me
DB_SCHEMA=zi_tw
DB_POOL_MAX=10

DEV_USER_ID=00000000-0000-4000-8000-000000000001
AUTH_SESSION_DAYS=30
AUTH_COOKIE_SECURE=false
SOCIAL_MATCH_MIN_SCORE=60
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=45000
DEEPSEEK_MAX_RETRIES=2

# Development may use local storage. Production config validation requires private S3,
# envelope encryption and ClamAV.
MEDIA_LOCAL_DIR=uploads
MEDIA_STORAGE_PROVIDER=local
MEDIA_ENCRYPTION_KEY_ID=traceweave-media-v1
# 32 random bytes encoded as Base64, for example: openssl rand -base64 32
MEDIA_ENCRYPTION_KEY=
# JSON object of historical key IDs to Base64 keys. Keep old keys here during rotation.
MEDIA_ENCRYPTION_KEYRING=
MEDIA_S3_REGION=auto
MEDIA_S3_BUCKET=
MEDIA_S3_ENDPOINT=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_FORCE_PATH_STYLE=false
# Required in production; use the KMS key ARN/ID accepted by the S3-compatible service.
MEDIA_S3_KMS_KEY_ID=
MEDIA_SCAN_MODE=off
CLAMAV_HOST=
CLAMAV_PORT=3310
MEDIA_MAX_BYTES=26214400
MEDIA_MAX_FILES=12
MEDIA_MAX_TOTAL_BYTES=104857600
NOTIFICATION_SWEEP_SECONDS=60
OUTBOX_SWEEP_SECONDS=2
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=8
DELETION_SWEEP_SECONDS=3
DELETION_MAX_ATTEMPTS=5

# Optional server-side speech-to-text fallback for browsers without Web Speech.
STT_PROVIDER=disabled
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1
STT_TIMEOUT_MS=120000

# Standard Web Push. Generate a VAPID pair with: npx web-push generate-vapid-keys
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=

# Required in production. Send as Authorization: Bearer <token> to /api/metrics.
METRICS_TOKEN=

# Optional: use a PostgreSQL client inside this container when the local
# pg_dump major version is older than the database server.
TRACEWEAVE_PG_DUMP_CONTAINER=
TRACEWEAVE_PG_DUMP_CONTAINER_PORT=5432
