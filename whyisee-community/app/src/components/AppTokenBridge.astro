---
// app 会话交接：仅当页面跑在 Flutter WebView 里（存在 window.FlutterBridge）时生效。
// 普通浏览器里这段脚本第一行就 return，不影响网页任何行为。
//
// 作用：网页登录成功后，把当前 cookie 会话换成 app 能用的 Bearer token 交给原生层。
// 服务端 /api/v1/auth/session-from-cookie 会把这条会话标记成 app 会话并延长到 90 天，
// 所以网页退登后 app 也会跟着失效，不需要额外同步。
---

<script is:inline>
  (function () {
    if (!window.FlutterBridge || typeof window.FlutterBridge.postMessage !== "function") return;

    var APP_VERSION = "0.1.0";
    var lastToken = "";

    function post(message) {
      try {
        window.FlutterBridge.postMessage(JSON.stringify(message));
      } catch (error) {
        /* 桥不可用就静默，不打断网页 */
      }
    }

    function syncToken() {
      fetch("/api/v1/auth/session-from-cookie", {
        method: "POST",
        credentials: "include",
        headers: {
          "content-type": "application/json",
          "x-app-version": APP_VERSION,
        },
        body: "{}",
      })
        .then(function (response) {
          return response.ok ? response.json() : null;
        })
        .then(function (body) {
          if (!body || !body.ok || !body.data || !body.data.token) return;
          if (body.data.token === lastToken) return;
          lastToken = body.data.token;
          post({ type: "token", payload: body.data });
        })
        .catch(function () {
          /* 未登录 / 网络问题，忽略 */
        });
    }

    syncToken();

    document.addEventListener("visibilitychange", function () {
      if (!document.hidden) syncToken();
    });
  })();
</script>
